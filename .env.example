# Reddit API credentials (register at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=nba-sentiment-pro/1.0 by your_reddit_username

# Database
DATABASE_URL=sqlite:///./data/nba_sentiment.db

# Model config
MODEL_NAME=distilbert-base-uncased
MODEL_CHECKPOINT_DIR=./training/checkpoints
USE_FINE_TUNED=false

# API settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: HuggingFace Hub (for pushing trained models)
HUGGINGFACE_TOKEN=your_hf_token_here
